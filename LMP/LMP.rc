                    WS_EX_CLIENTEDGE
    GROUPBOX        "[LOG INFORMATION]",IDC_STATIC,12,47,241,50,BS_FLAT
    EDITTEXT        IDC_EDIT_PATH,82,76,143,14,ES_CENTER | ES_READONLY | 
                    ES_NUMBER
    LTEXT           "# PATH",IDC_STATIC,19,80,25,8
    GROUPBOX        "[LOG LIST]",IDC_STATIC,12,108,241,167,BS_FLAT
    CTEXT           "",IDC_STATIC_TIME,64,13,132,23,SS_CENTERIMAGE | 
